{
  "_comment": [
    "A curated catalogue of predefined roles, covering what a landing zone",
    "actually uses. Google publishes roughly 1,250 roles and 10,000",
    "permissions with no offline feed, so this is deliberately a subset and",
    "says so: every entry is marked curated, and MiniSky reports a permission",
    "answer as drawn from a curated list rather than as a verdict.",
    "",
    "Extend or replace it with ~/.minisky/roles.json, which overlays this by",
    "role name. Use the same shape:",
    "  { \"roles\": { \"roles/example.admin\": { \"permissions\": [\"a.b.c\"] } } }"
  ],
  "roles": {
    "roles/owner": {
      "title": "Owner",
      "includes": ["roles/editor"],
      "permissions": [
        "resourcemanager.projects.delete",
        "resourcemanager.projects.setIamPolicy",
        "resourcemanager.folders.setIamPolicy",
        "resourcemanager.organizations.setIamPolicy",
        "iam.roles.create", "iam.roles.delete", "iam.roles.update"
      ]
    },
    "roles/editor": {
      "title": "Editor",
      "includes": ["roles/viewer"],
      "permissions": [
        "resourcemanager.projects.update",
        "compute.instances.create", "compute.instances.delete", "compute.instances.start",
        "compute.instances.stop", "compute.networks.create", "compute.firewalls.create",
        "storage.buckets.create", "storage.buckets.delete", "storage.objects.create",
        "storage.objects.delete", "bigquery.datasets.create", "bigquery.datasets.delete",
        "bigquery.tables.create", "bigquery.tables.delete", "bigquery.tables.updateData",
        "pubsub.topics.create", "pubsub.topics.delete", "pubsub.topics.publish",
        "pubsub.subscriptions.create", "pubsub.subscriptions.consume",
        "cloudsql.instances.create", "cloudsql.instances.delete",
        "container.clusters.create", "container.clusters.delete",
        "secretmanager.secrets.create", "secretmanager.versions.add"
      ]
    },
    "roles/viewer": {
      "title": "Viewer",
      "permissions": [
        "resourcemanager.projects.get", "resourcemanager.projects.list",
        "resourcemanager.folders.get", "resourcemanager.folders.list",
        "resourcemanager.organizations.get",
        "compute.instances.get", "compute.instances.list",
        "compute.networks.get", "compute.networks.list", "compute.firewalls.list",
        "storage.buckets.get", "storage.buckets.list", "storage.objects.get",
        "storage.objects.list", "bigquery.datasets.get", "bigquery.tables.get",
        "bigquery.tables.list", "bigquery.tables.getData",
        "pubsub.topics.get", "pubsub.topics.list", "pubsub.subscriptions.get",
        "cloudsql.instances.get", "cloudsql.instances.list",
        "container.clusters.get", "container.clusters.list",
        "logging.logEntries.list", "monitoring.timeSeries.list"
      ]
    },
    "roles/browser": {
      "title": "Browser",
      "permissions": [
        "resourcemanager.projects.get", "resourcemanager.projects.list",
        "resourcemanager.folders.get", "resourcemanager.folders.list",
        "resourcemanager.organizations.get"
      ]
    },

    "roles/resourcemanager.organizationAdmin": {
      "title": "Organization Administrator",
      "permissions": [
        "resourcemanager.organizations.get", "resourcemanager.organizations.getIamPolicy",
        "resourcemanager.organizations.setIamPolicy",
        "resourcemanager.folders.create", "resourcemanager.folders.delete",
        "resourcemanager.folders.get", "resourcemanager.folders.list",
        "resourcemanager.folders.move", "resourcemanager.folders.update",
        "resourcemanager.folders.getIamPolicy", "resourcemanager.folders.setIamPolicy",
        "resourcemanager.projects.get", "resourcemanager.projects.list"
      ]
    },
    "roles/resourcemanager.folderAdmin": {
      "title": "Folder Administrator",
      "permissions": [
        "resourcemanager.folders.create", "resourcemanager.folders.delete",
        "resourcemanager.folders.get", "resourcemanager.folders.list",
        "resourcemanager.folders.move", "resourcemanager.folders.update",
        "resourcemanager.folders.undelete",
        "resourcemanager.folders.getIamPolicy", "resourcemanager.folders.setIamPolicy",
        "resourcemanager.projects.get", "resourcemanager.projects.list"
      ]
    },
    "roles/resourcemanager.folderCreator": {
      "title": "Folder Creator",
      "permissions": [
        "resourcemanager.folders.create", "resourcemanager.folders.get",
        "resourcemanager.folders.list"
      ]
    },
    "roles/resourcemanager.folderViewer": {
      "title": "Folder Viewer",
      "permissions": [
        "resourcemanager.folders.get", "resourcemanager.folders.list",
        "resourcemanager.projects.get", "resourcemanager.projects.list"
